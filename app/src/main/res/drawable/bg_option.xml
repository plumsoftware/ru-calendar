<?xml version="1.0" encoding="utf-8"?>
<!-- Вариант упреждения: выбранный — тёмная заливка, остальные — обводка -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1F000000">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/ds_button_primary_bg" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/ds_surface" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/ds_outline" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
