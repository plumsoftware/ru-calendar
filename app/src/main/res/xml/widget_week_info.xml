<?xml version="1.0" encoding="utf-8"?>
<!-- Обновляется в 00:00, при смене часового пояса и после перезагрузки — см. WidgetUpdater -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_week_description"
    android:initialLayout="@layout/widget_week"
    android:minWidth="250dp"
    android:minHeight="140dp"
    android:previewLayout="@layout/widget_week"
    android:resizeMode="none"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
