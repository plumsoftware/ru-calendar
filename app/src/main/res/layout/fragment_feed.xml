<?xml version="1.0" encoding="utf-8"?>
<!-- Лента ближайших событий (ТЗ п. 4.4) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/feed_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg_screen"
    android:orientation="vertical">

    <!-- Верхний отступ добавляется в коде с учётом строки состояния -->
    <LinearLayout
        android:id="@+id/feed_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/feed_title"
            android:textAppearance="@style/TextAppearance.Calendar.ScreenTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_search_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search"
                app:tint="@color/ds_text_secondary" />

            <EditText
                android:id="@+id/search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/golos_text_regular"
                android:hint="@string/feed_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/ds_text_primary"
                android:textColorHint="@color/ds_text_secondary"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Чип «Избранное»: показывать только праздники, отмеченные звёздочкой -->
        <TextView
            android:id="@+id/favorites_chip"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:clickable="true"
            android:drawablePadding="8dp"
            android:focusable="true"
            android:fontFamily="@font/golos_text_medium"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:text="@string/feed_favorites"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:text="@string/feed_empty"
            android:textAppearance="@style/TextAppearance.Calendar.Body"
            android:visibility="gone" />

        <!-- Баннер на главной странице: внизу «Ленты», над нижней панелью (отступ задаётся в коде) -->
        <FrameLayout
            android:id="@+id/ad_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/ds_bg_screen"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
