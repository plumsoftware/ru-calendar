<?xml version="1.0" encoding="utf-8"?>
<!-- О празднике (ТЗ п. 4.3) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/holiday_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg_screen">

<androidx.core.widget.NestedScrollView
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Шапка цвета типа, нижние углы 36 dp; верхний отступ добавляется в коде -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/back"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_white"
                    android:contentDescription="@string/cd_back"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#15171C" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/share"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/cd_share"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_share"
                    app:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/favorite"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/cd_favorite_add"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_favorite"
                    app:tint="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/day_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/unbounded_bold"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.04"
                    android:textColor="#FFFFFF"
                    android:textSize="96sp"
                    tools:text="4" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/month_genitive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/unbounded_medium"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        tools:text="ноября" />

                    <TextView
                        android:id="@+id/weekday_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/golos_text_regular"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        tools:text="среда · 2026" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityHeading="true"
                android:fontFamily="@font/golos_text_bold"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                tools:targetApi="p"
                tools:text="День народного единства" />

            <com.plumsoftware.rucalendar.ui.FlowLayout
                android:id="@+id/chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_section"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/detail_about"
                    android:textAppearance="@style/TextAppearance.Calendar.SectionHeader"
                    tools:targetApi="p" />

                <!-- Полный текст без обрезки, абзацы из базы сохраняются -->
                <TextView
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/golos_text_regular"
                    android:lineSpacingExtra="5sp"
                    android:textColor="@color/ds_text_primary"
                    android:textIsSelectable="true"
                    android:textSize="16sp" />
            </LinearLayout>

            <include
                layout="@layout/view_reminder_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_section"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/detail_other_years"
                    android:textAppearance="@style/TextAppearance.Calendar.SectionHeader"
                    tools:targetApi="p" />

                <LinearLayout
                    android:id="@+id/other_years"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

    <!-- Баннер всегда внизу экрана, не прокручивается; под него у контента добавляется отступ -->
    <FrameLayout
        android:id="@+id/ad_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/ds_bg_screen"
        android:visibility="gone" />
</FrameLayout>
