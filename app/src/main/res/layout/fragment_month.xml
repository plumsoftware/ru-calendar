<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <!-- Отступы сверху и снизу добавляются в коде с учётом системных панелей -->
        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Шапка: год, месяц, кнопки -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/month_title_block"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:minHeight="44dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Calendar.Overline"
                        tools:text="2026" />

                    <TextView
                        android:id="@+id/month_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.Calendar.ScreenTitle"
                        tools:text="Октябрь" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/prev_month"
                    style="@style/Widget.Calendar.IconButton"
                    android:contentDescription="@string/cd_prev_month"
                    android:src="@drawable/ic_chevron_left" />

                <ImageButton
                    android:id="@+id/next_month"
                    style="@style/Widget.Calendar.IconButton"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/cd_next_month"
                    android:src="@drawable/ic_chevron_right" />

                <ImageButton
                    android:id="@+id/search"
                    style="@style/Widget.Calendar.IconButton"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_icon_button_dark"
                    android:contentDescription="@string/cd_search"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_search"
                    app:tint="@color/ds_button_primary_text" />
            </LinearLayout>

            <!-- Фильтры: чипы создаются в коде -->
            <HorizontalScrollView
                android:id="@+id/chips_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-16dp"
                android:layout_marginEnd="-16dp"
                android:layout_marginTop="14dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Сетка месяца -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/weekdays"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="horizontal" />

                <com.plumsoftware.rucalendar.ui.month.MonthGridView
                    android:id="@+id/grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Список событий выбранного дня -->
            <LinearLayout
                android:id="@+id/day_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:animateLayoutChanges="false"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/day_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:textAppearance="@style/TextAppearance.Calendar.CardTitleSmall"
                        tools:targetApi="p"
                        tools:text="Суббота, 3 октября" />

                    <TextView
                        android:id="@+id/day_relative"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_rel_chip"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textAppearance="@style/TextAppearance.Calendar.ChipSmall"
                        android:textColor="@color/ds_rel_chip_text"
                        tools:text="сегодня" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/day_events"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/day_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/day_empty"
                    android:textAppearance="@style/TextAppearance.Calendar.Body"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Плашка «Ближайший выходной по календарю» -->
            <LinearLayout
                android:id="@+id/nearest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_promo"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/golos_text_regular"
                        android:text="@string/nearest_label"
                        android:textColor="@color/ds_promo_label"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/nearest_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/golos_text_semibold"
                        android:textColor="@color/ds_promo_text"
                        android:textSize="15sp"
                        tools:text="4 ноября · День народного единства" />
                </LinearLayout>

                <TextView
                    android:id="@+id/nearest_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_promo_counter"
                    android:fontFamily="@font/unbounded_bold"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textColor="@color/ds_on_holiday_plate"
                    android:textSize="13sp"
                    tools:text="32 дня" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Кнопка «+», п. 4.1: справа, на 8 dp выше нижней панели (отступ задаётся в коде) -->
    <ImageButton
        android:id="@+id/fab_add"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_fab"
        android:contentDescription="@string/cd_add_event"
        android:padding="15dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_add"
        app:tint="@color/ds_on_fab" />
</FrameLayout>
