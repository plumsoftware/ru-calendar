<?xml version="1.0" encoding="utf-8"?>
<!-- Новое событие / Изменить событие (ТЗ п. 4.6) -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_bg_screen"
    android:clipToPadding="false">

    <!-- Отступы сверху и снизу добавляются в коде -->
    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Шапка -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/close"
                style="@style/Widget.Calendar.IconButton"
                android:contentDescription="@string/cd_close_without_saving"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close" />

            <TextView
                android:id="@+id/screen_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:fontFamily="@font/unbounded_bold"
                android:text="@string/event_new_title"
                android:textColor="@color/ds_text_primary"
                android:textSize="19sp"
                tools:targetApi="p" />

            <TextView
                android:id="@+id/save"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_button_primary"
                android:fontFamily="@font/golos_text_semibold"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/event_save"
                android:textColor="@color/ds_button_primary_text"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Предпросмотр «Так будет в календаре» -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/event_preview"
                android:textAppearance="@style/TextAppearance.Calendar.SectionHeader" />

            <LinearLayout
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="52dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_inset_block"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/preview_day"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/golos_text_semibold"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="16sp"
                        tools:text="17" />

                    <ImageView
                        android:id="@+id/preview_day_star"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginTop="3dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_star_filled" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/preview_plate"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="12dp"
                    android:importantForAccessibility="no"
                    android:padding="12dp"
                    android:src="@drawable/ic_star_filled" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/preview_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Calendar.ListItem"
                        tools:text="День рождения мамы" />

                    <TextView
                        android:id="@+id/preview_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.Calendar.Caption"
                        tools:text="Моё событие · каждый год" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Название и описание -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/label_title"
                style="@style/Widget.Calendar.FieldLabel"
                android:labelFor="@+id/input_title"
                android:text="@string/event_field_title" />

            <EditText
                android:id="@+id/input_title"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_strong"
                android:fontFamily="@font/golos_text_semibold"
                android:hint="@string/event_field_title_hint"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="60"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/ds_text_primary"
                android:textColorHint="@color/ds_text_secondary"
                android:textSize="16sp" />

            <TextView
                style="@style/Widget.Calendar.FieldLabel"
                android:layout_marginTop="14dp"
                android:labelFor="@+id/input_description"
                android:text="@string/event_field_description" />

            <EditText
                android:id="@+id/input_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:fontFamily="@font/golos_text_regular"
                android:gravity="top|start"
                android:hint="@string/event_field_description_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:lineSpacingExtra="6sp"
                android:maxLength="500"
                android:maxLines="6"
                android:minLines="3"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp"
                android:scrollbars="vertical"
                android:textColor="@color/ds_text_primary"
                android:textColorHint="@color/ds_text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Дата и повтор -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:id="@+id/date_row"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/ds_text_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/event_field_date"
                        android:textAppearance="@style/TextAppearance.Calendar.Caption" />

                    <TextView
                        android:id="@+id/date_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/golos_text_semibold"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="16sp"
                        tools:text="Суббота, 17 октября 2026" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/ds_text_secondary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/ds_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/yearly_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/golos_text_medium"
                    android:importantForAccessibility="no"
                    android:text="@string/event_yearly"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="16sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/yearly_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:checked="true"
                    android:contentDescription="@string/event_yearly"
                    android:thumb="@drawable/switch_thumb"
                    app:switchMinWidth="52dp"
                    app:track="@drawable/switch_track" />
            </LinearLayout>
        </LinearLayout>

        <!-- Цвет -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/event_color"
                    android:textAppearance="@style/TextAppearance.Calendar.SectionHeader" />

                <LinearLayout
                    android:id="@+id/color_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_color_badge"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="12dp">

                    <View
                        android:id="@+id/color_badge_swatch"
                        android:layout_width="16dp"
                        android:layout_height="16dp" />

                    <TextView
                        android:id="@+id/color_badge_hex"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/unbounded_medium"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="12sp"
                        tools:text="#7A4DD8" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Widget.Calendar.FieldLabel"
                android:layout_marginTop="14dp"
                android:text="@string/event_recent_colors" />

            <!-- Пять недавних цветов: круги 36 dp в области нажатия 48 dp -->
            <LinearLayout
                android:id="@+id/recent_colors"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="@color/ds_divider" />

            <TextView
                style="@style/Widget.Calendar.FieldLabel"
                android:layout_marginTop="14dp"
                android:text="@string/event_custom_color" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/golos_text_regular"
                android:importantForAccessibility="no"
                android:text="@string/event_hue"
                android:textColor="@color/ds_text_body"
                android:textSize="13sp" />

            <com.plumsoftware.rucalendar.ui.event.ColorSliderView
                android:id="@+id/hue_slider"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:contentDescription="@string/event_hue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/golos_text_regular"
                android:importantForAccessibility="no"
                android:text="@string/event_lightness"
                android:textColor="@color/ds_text_body"
                android:textSize="13sp" />

            <com.plumsoftware.rucalendar.ui.event.ColorSliderView
                android:id="@+id/lightness_slider"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:contentDescription="@string/event_lightness" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/event_color_note"
                android:textAppearance="@style/TextAppearance.Calendar.Caption" />
        </LinearLayout>

        <include
            layout="@layout/view_reminder_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

        <!-- Только в режиме редактирования -->
        <TextView
            android:id="@+id/delete"
            style="@style/Widget.Calendar.OutlineButton"
            android:layout_width="match_parent"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_button_danger"
            android:text="@string/event_delete"
            android:textColor="@color/ds_weekend_text"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
