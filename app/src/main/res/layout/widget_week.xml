<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «Эта неделя» 4 × 2 (ТЗ п. 5.1); следует системной теме -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_surface"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/unbounded_bold"
            android:text="@string/widget_week_title"
            android:textColor="@color/ds_text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/week_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/golos_text_regular"
            android:textColor="@color/ds_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/week_day_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/week_label_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/golos_text_regular"
                android:textColor="@color/ds_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/week_number_0"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/golos_text_semibold"
                android:gravity="center"
                android:textColor="@color/ds_text_primary"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/week_markers_0"
                android:layout_width="40dp"
                android:layout_height="10dp"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/week_day_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/week_label_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/golos_text_regular"
                android:textColor="@color/ds_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/week_number_1"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/golos_text_semibold"
                android:gravity="center"
                android:textColor="@color/ds_text_primary"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/week_markers_1"
                android:layout_width="40dp"
                android:layout_height="10dp"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/week_day_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/week_label_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/golos_text_regular"
                android:textColor="@color/ds_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/week_number_2"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/golos_text_semibold"
                android:gravity="center"
                android:textColor="@color/ds_text_primary"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/week_markers_2"
                android:layout_width="40dp"
                android:layout_height="10dp"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/week_day_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/week_label_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/golos_text_regular"
                android:textColor="@color/ds_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/week_number_3"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/golos_text_semibold"
                android:gravity="center"
                android:textColor="@color/ds_text_primary"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/week_markers_3"
                android:layout_width="40dp"
                android:layout_height="10dp"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/week_day_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/week_label_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/golos_text_regular"
                android:textColor="@color/ds_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/week_number_4"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/golos_text_semibold"
                android:gravity="center"
                android:textColor="@color/ds_text_primary"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/week_markers_4"
                android:layout_width="40dp"
                android:layout_height="10dp"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/week_day_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/week_label_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/golos_text_regular"
                android:textColor="@color/ds_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/week_number_5"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/golos_text_semibold"
                android:gravity="center"
                android:textColor="@color/ds_text_primary"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/week_markers_5"
                android:layout_width="40dp"
                android:layout_height="10dp"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/week_day_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/week_label_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/golos_text_regular"
                android:textColor="@color/ds_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/week_number_6"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/golos_text_semibold"
                android:gravity="center"
                android:textColor="@color/ds_text_primary"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/week_markers_6"
                android:layout_width="40dp"
                android:layout_height="10dp"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/week_events"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Разделитель: обычный View в RemoteViews до API 31 не поддерживается -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/ds_divider"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/week_event_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/week_event_marker_0"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/week_event_title_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/golos_text_semibold"
                android:maxLines="1"
                android:textColor="@color/ds_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/week_event_relative_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/golos_text_regular"
                android:textColor="@color/ds_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/week_event_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/week_event_marker_1"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/week_event_title_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/golos_text_semibold"
                android:maxLines="1"
                android:textColor="@color/ds_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/week_event_relative_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/golos_text_regular"
                android:textColor="@color/ds_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
